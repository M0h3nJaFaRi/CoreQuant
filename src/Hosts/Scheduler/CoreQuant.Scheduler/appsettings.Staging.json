{
  "Framework": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.Hosting.Lifetime": "Information",
          "Microsoft.EntityFrameworkCore": "Warning",
          "System": "Warning"
        }
      },
      "Console": {
        "Enabled": false
      }
    },
    "Syslog": {
      "Enabled": false,
      "RestrictedToMinimumLevel": "Information"
    }
  },
  "Infrastructure": {
    "Databases": {
      "Write": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": ""
      },
      "Read": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": ""
      }
    },
    "Redis": {
      "Host": "",
      "Port": 6379,
      "Password": ""
    }
  },
  "Application": {
    "Outbox": {
      "Transport": "Logging",
      "SchedulerIntervalSeconds": 15
    }
  }
}
