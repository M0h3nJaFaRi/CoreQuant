{
  "ApplicationName": "CoreQuant",
  "ApplicationComponent": "Worker",
  "Framework": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.Hosting.Lifetime": "Information",
          "Microsoft.EntityFrameworkCore": "Warning",
          "System": "Warning"
        }
      },
      "Console": {
        "Enabled": false
      }
    },
    "Syslog": {
      "Enabled": false,
      "Address": "",
      "Port": 0,
      "Format": "RFC5424",
      "RestrictedToMinimumLevel": "Information"
    },
    "Health": {
      "LivenessPath": "/health/live",
      "ReadinessPath": "/health/ready"
    },
    "Metrics": {
      "Enabled": true,
      "Path": "/metrics"
    },
    "Resilience": {
      "Retry": {
        "UseJitter": true,
        "Delay": "00:00:02",
        "MaxRetryAttempts": 3
      },
      "Timeout": "00:00:15",
      "CircuitBreaker": {
        "FailureThreshold": 3,
        "BreakDuration": "00:01:00"
      }
    },
    "Encryption": {
      "RSA": {
        "PublicKey": "",
        "PrivateKey": ""
      },
      "AES": {
        "Key": "",
        "IV": ""
      }
    }
  },
  "Infrastructure": {
    "Databases": {
      "Core": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "News": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "Forex": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "Index": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "Metal": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "Stock": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "Crypto": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      },
      "Commodity": {
        "Host": "",
        "Port": 3306,
        "Username": "",
        "Password": "",
        "Name": "",
        "CommandTimeout": "00:00:30"
      }
    },
    "Redis": {
      "Host": "127.0.0.1",
      "Port": 6379,
      "Password": "",
      "HostRole": "Worker",
      "Cache": { "Database": 0 },
      "Idempotency": { "Database": 1 },
      "RateLimit": { "Database": 2 },
      "Token": { "Database": 3 },
      "Lock": { "Database": 4 },
      "EventStore": {
        "Database": 5,
        "DefaultStream": "integration",
        "MaxStreamLength": 10000
      },
      "Queue": {
        "Database": 6,
        "MaxStreamLength": 10000
      },
      "Health": {
        "Enabled": true,
        "Timeout": "00:00:02"
      },
      "Connection": {
        "AsyncTimeout": "00:00:15",
        "ConnectTimeout": "00:00:05",
        "SyncTimeout": "00:01:00",
        "ConnectRetry": 3,
        "KeepAlive": "00:01:00"
      }
    },
    "Persistence": {
      "SlowQuery": {
        "WarningThreshold": "00:00:00.250",
        "ErrorThreshold": "00:00:00.500",
        "CriticalThreshold": "00:00:01",
        "EmitCommandSpans": false
      }
    }
  }
