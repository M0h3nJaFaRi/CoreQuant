{
  "Framework": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.Hosting.Lifetime": "Information",
          "System": "Warning"
        }
      },
      "Console": {
        "Enabled": false
      }
