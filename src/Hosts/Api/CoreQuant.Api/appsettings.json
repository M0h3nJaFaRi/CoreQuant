  "Middlewares": {
    "RequestTimeouts": {
      "DefaultSeconds": 15,
      "FastSeconds": 5,
      "StandardSeconds": 15,
      "LongRunningSeconds": 45,
      "ThirdPartySeconds": 60
    },
    "RequestLogging": {
      "QuietPaths": [ "/health", "/metrics" ]
    },
    "ApiKey": {
      "HeaderName": "X-API-Key",
      "Clients": {
        "market-domestic-collector": {
          "Enabled": true,
          "Keys": [ "market-domestic-sample-key-1", "market-domestic-sample-key-2" ]
        },
        "market-global-collector": {
          "Enabled": true,
          "Keys": [ "market-global-sample-key-1", "market-global-sample-key-2" ]
        },
        "mobile-app": {
          "Enabled": true,
          "Keys": [ "mobile-app-sample-key-1", "mobile-app-sample-key-2" ]
        }
      },
      "ExcludedPaths": [ "/health", "/swagger", "/openapi", "/metrics" ]
    },
    "Maintenance": {
      "Enabled": false,
      "ExcludedPaths": [ "/health", "/metrics" ],
      "Message": "Service is temporarily unavailable due to scheduled maintenance. Please try again later.",
      "RetryAfterSeconds": 300
    }
  }
