{
  "Name": "CoreQuant",
  "Component": "Api",
  "AllowedHosts": "*",
  "Framework": {
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.EntityFrameworkCore": "Warning",
          "System": "Warning"
        }
      },
      "Console": {
        "Enabled": false
      }
    },
    "Syslog": {
      "Enabled": false,
      "Address": "",
      "Port": 0,
      "Format": "RFC5424",
      "RestrictedToMinimumLevel": "Information"
    },
    "Health": {
      "LivenessPath": "/health/live",
      "ReadinessPath": "/health/ready"
    },
    "Metrics": {
      "Enabled": true,
      "Path": "/metrics"
    },
    "Resilience": {
      "Retry": {
        "UseJitter": true,
        "Delay": "00:00:02",
        "MaxRetryAttempts": 3
      },
      "Timeout": "00:00:15",
      "CircuitBreaker": {
        "FailureThreshold": 3,
        "BreakDuration": "00:01:00"
      }
    },
    "Encryption": {
      "RSA": {
        "PublicKey": "",
        "PrivateKey": ""
      },
      "AES": {
        "Key": "",
        "IV": ""
      }
    }
  },
